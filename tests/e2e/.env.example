# Target Unraid server for the e2e suite (`composer test:e2e`).
# Copy to tests/e2e/.env (untracked) and adjust. Real env vars take precedence.

# Required: LAN IP or hostname of the Unraid server. SSH key auth for root
# must already be set up (ssh root@<host> must work without a password).
E2E_HOST=192.168.1.100

# Optional overrides (defaults shown).
#E2E_SSH_USER=root
#E2E_PLUGIN=easy.rsync.beta
#E2E_SCHEME=https

# Opt-in: assert real Unraid notifications. Creates genuine notifications on
# the server, so any configured notification agents (email/Discord/...) WILL
# fire. The test removes the notification files afterwards.
#E2E_ALLOW_NOTIFICATIONS=1

# Opt-in: a remote rsync-over-ssh destination ([user@]host:/path) that the
# UNRAID SERVER can reach with key auth. Enables the remote-destination tests.
#E2E_REMOTE_DEST=user@otherhost:/tmp/easy-rsync-e2e-remote
